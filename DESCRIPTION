Package: employmentEarlyPsychosis
Type: Package
Title: Employment in First-Episode Psychosis: Systematic Review and Bayesian Meta-Analysis (research compendium)
Version: 1.1.0.9000
Authors@R: c(
    person("Hazal", "Kaplankiran", role = "aut"),
    person("Yanan", "Li", role = "aut"),
